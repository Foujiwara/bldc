<?xml version="1.0" encoding="UTF-8"?>
<ConfigParams>
    <Params>
        <config_name>
            <longName>none</longName>
            <type>3</type>
            <transmittable>0</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine></cDefine>
            <valString>rfp_config</valString>
            <maxLen>0</maxLen>
        </config_name>
        <hw_name>
            <longName>RFP Extras</longName>
            <type>0</type>
            <transmittable>0</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Extra functions added by the RFP build.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine></cDefine>
        </hw_name>
        <basic_duty_enable>
            <longName>Basic Duty Mode</longName>
            <type>5</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Duty control: when the requested duty drops below the present duty, the motor is released: no braking and no acceleration (zero current, the bridge stays on) until the duty falls to the request, then it follows it again. Example: at 100 % the request goes down to 50 %, the motor coasts down to 50 % duty and takes over. Off: the Duty Downramp regulator brakes to follow a falling request. A request of zero always releases the motor.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>RFP_BASIC_DUTY_ENABLE</cDefine>
            <valInt>0</valInt>
        </basic_duty_enable>
        <hybrid_enable>
            <longName>Hybrid Current / Duty Control</longName>
            <type>5</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;For every input that sends a relative current (ADC, PPM, VESC Remote, PAS, CAN): the duty cycle is limited proportionally to the throttle, so half throttle gives half torque and, without load, about half speed. In current control alone, a few percent of throttle bring an unloaded motor to full speed. Duty limit = throttle x Duty Limit at Full Throttle x Maximum Duty Cycle. The current is reduced linearly over the Current Taper Band below the limit and reaches zero at the limit, without a sudden cut. Braking is not affected.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>RFP_HYBRID_ENABLE</cDefine>
            <valInt>0</valInt>
        </hybrid_enable>
        <hybrid_duty_limit>
            <longName>Duty Limit at Full Throttle</longName>
            <type>1</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Duty cycle limit at full throttle, as a fraction of Maximum Duty Cycle. Lower it to cap the top speed.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>RFP_HYBRID_DUTY_LIMIT</cDefine>
            <editorDecimalsDouble>2</editorDecimalsDouble>
            <editorScale>1</editorScale>
            <editAsPercentage>0</editAsPercentage>
            <maxDouble>1</maxDouble>
            <minDouble>0.05</minDouble>
            <showDisplay>0</showDisplay>
            <stepDouble>0.01</stepDouble>
            <valDouble>1</valDouble>
            <vTxDoubleScale>1000</vTxDoubleScale>
            <suffix></suffix>
            <vTx>9</vTx>
        </hybrid_duty_limit>
        <hybrid_band>
            <longName>Current Taper Band</longName>
            <type>1</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Part of the duty limit over which the current decreases to zero. Wider: softer approach of the limit, the speed settles a little lower under load. Narrower: firmer, the current is held closer to the limit.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>RFP_HYBRID_BAND</cDefine>
            <editorDecimalsDouble>2</editorDecimalsDouble>
            <editorScale>1</editorScale>
            <editAsPercentage>0</editAsPercentage>
            <maxDouble>0.6</maxDouble>
            <minDouble>0.02</minDouble>
            <showDisplay>0</showDisplay>
            <stepDouble>0.01</stepDouble>
            <valDouble>0.15</valDouble>
            <vTxDoubleScale>1000</vTxDoubleScale>
            <suffix></suffix>
            <vTx>9</vTx>
        </hybrid_band>
        <smart_rev_enable>
            <longName>Smart Reverse</longName>
            <type>5</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;For every input that sends a relative current (ADC, PPM, VESC Remote, PAS, CAN): a negative request (reverse) while rolling forward faster than Smart Reverse Brake Above ERPM brakes, with a current proportional to the request. Below that speed the motor reverses at a limited duty cycle, reached with a ramp. Inputs that already have their own smart reverse (PPM, VESC Remote) keep it.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>RFP_SMART_REV_ENABLE</cDefine>
            <valInt>0</valInt>
        </smart_rev_enable>
        <smart_rev_erpm>
            <longName>Smart Reverse Brake Above ERPM</longName>
            <type>1</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Forward speed above which a reverse request brakes. Below it, the motor reverses.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>RFP_SMART_REV_ERPM</cDefine>
            <editorDecimalsDouble>0</editorDecimalsDouble>
            <editorScale>1</editorScale>
            <editAsPercentage>0</editAsPercentage>
            <maxDouble>30000</maxDouble>
            <minDouble>0</minDouble>
            <showDisplay>0</showDisplay>
            <stepDouble>100</stepDouble>
            <valDouble>1000</valDouble>
            <vTxDoubleScale>1000</vTxDoubleScale>
            <suffix> ERPM</suffix>
            <vTx>9</vTx>
        </smart_rev_erpm>
        <smart_rev_max_duty>
            <longName>Smart Reverse Max Duty Cycle</longName>
            <type>1</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Duty cycle in reverse at full request.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>RFP_SMART_REV_MAX_DUTY</cDefine>
            <editorDecimalsDouble>2</editorDecimalsDouble>
            <editorScale>1</editorScale>
            <editAsPercentage>0</editAsPercentage>
            <maxDouble>1</maxDouble>
            <minDouble>0</minDouble>
            <showDisplay>0</showDisplay>
            <stepDouble>0.01</stepDouble>
            <valDouble>0.07</valDouble>
            <vTxDoubleScale>1000</vTxDoubleScale>
            <suffix></suffix>
            <vTx>9</vTx>
        </smart_rev_max_duty>
        <smart_rev_ramp>
            <longName>Smart Reverse Ramp Time</longName>
            <type>1</type>
            <transmittable>1</transmittable>
            <description>&lt;!DOCTYPE HTML PUBLIC &quot;-//W3C//DTD HTML 4.0//EN&quot; &quot;http://www.w3.org/TR/REC-html40/strict.dtd&quot;&gt;
&lt;html&gt;&lt;head&gt;&lt;meta name=&quot;qrichtext&quot; content=&quot;1&quot; /&gt;&lt;style type=&quot;text/css&quot;&gt;
p, li { white-space: pre-wrap; }
&lt;/style&gt;&lt;/head&gt;&lt;body style=&quot; font-family:'Roboto'; ; font-weight:400; font-style:normal;&quot;&gt;
&lt;p style=&quot; margin-top:0px; margin-bottom:0px; margin-left:0px; margin-right:0px; -qt-block-indent:0; text-indent:0px;&quot;&gt;Time to go from 0 to Smart Reverse Max Duty Cycle.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</description>
            <cDefine>RFP_SMART_REV_RAMP</cDefine>
            <editorDecimalsDouble>2</editorDecimalsDouble>
            <editorScale>1</editorScale>
            <editAsPercentage>0</editAsPercentage>
            <maxDouble>20</maxDouble>
            <minDouble>0.01</minDouble>
            <showDisplay>0</showDisplay>
            <stepDouble>0.1</stepDouble>
            <valDouble>3</valDouble>
            <vTxDoubleScale>1000</vTxDoubleScale>
            <suffix> s</suffix>
            <vTx>9</vTx>
        </smart_rev_ramp>
    </Params>
    <SerOrder>
        <ser>basic_duty_enable</ser>
        <ser>hybrid_enable</ser>
        <ser>hybrid_duty_limit</ser>
        <ser>hybrid_band</ser>
        <ser>smart_rev_enable</ser>
        <ser>smart_rev_erpm</ser>
        <ser>smart_rev_max_duty</ser>
        <ser>smart_rev_ramp</ser>
    </SerOrder>
    <Grouping>
        <group>
            <groupName>General</groupName>
            <subgroup>
                <subgroupName>Duty</subgroupName>
                <subgroupParams>
                    <param>::sep::Basic Duty Mode</param>
                    <param>basic_duty_enable</param>
                </subgroupParams>
            </subgroup>
            <subgroup>
                <subgroupName>Current</subgroupName>
                <subgroupParams>
                    <param>::sep::Hybrid Current / Duty</param>
                    <param>hybrid_enable</param>
                    <param>hybrid_duty_limit</param>
                    <param>hybrid_band</param>
                    <param>::sep::Smart Reverse</param>
                    <param>smart_rev_enable</param>
                    <param>smart_rev_erpm</param>
                    <param>smart_rev_max_duty</param>
                    <param>smart_rev_ramp</param>
                </subgroupParams>
            </subgroup>
        </group>
    </Grouping>
</ConfigParams>
